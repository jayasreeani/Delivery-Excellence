{
  "name": "delivery-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Delivery Reporting & Insights Platform",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:setup": "cd backend && npm run db:setup",
    "db:seed": "cd backend && npm run db:seed",
    "backend:install": "cd backend && npm install",
    "frontend:install": "cd frontend && npm install",
    "install:all": "npm run backend:install && npm run frontend:install",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm run dev",
    "setup": "npm run install:all && npm run db:up && timeout /t 5 && npm run db:setup && npm run db:seed"
  }
}
