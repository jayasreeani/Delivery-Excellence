PORT=4000
DATABASE_URL=postgresql://delivery:delivery123@localhost:5432/delivery_platform
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000

# Jira Instance 1 (Web + Salesforce)
JIRA1_BASE_URL=https://your-org.atlassian.net
JIRA1_EMAIL=your-email@company.com
JIRA1_API_TOKEN=your-jira-api-token
JIRA1_PROJECT_KEY=WEB

# Jira Instance 2 (Mobile App)
JIRA2_BASE_URL=https://your-mobile-org.atlassian.net
JIRA2_EMAIL=your-email@company.com
JIRA2_API_TOKEN=your-jira-api-token
JIRA2_PROJECT_KEY=MOBILE

# Azure DevOps (GoGym)
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PROJECT=GoGym
AZURE_DEVOPS_PAT=your-personal-access-token

# Use mock data when true (no live API calls)
USE_MOCK_INTEGRATIONS=true
